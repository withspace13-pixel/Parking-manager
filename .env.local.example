NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 관리 앱 주소 (선택)
# NEXT_PUBLIC_APP_URL=https://app.example.com

# 설문 응답자용 공개 URL — 문자 {url}에 들어감 (관리 앱과 다른 도메인 권장)
# NEXT_PUBLIC_SURVEY_PUBLIC_URL=https://survey.withspace.kr
# 설문 도메인에서 /survey 외 경로 차단 (미들웨어, 위 URL과 동일 호스트)
# SURVEY_ONLY_HOST=survey.withspace.kr

# 솔라피 문자 발송 (서버 전용 — Git에 커밋하지 마세요)
SOLAPI_API_KEY=your-api-key
SOLAPI_API_SECRET=your-api-secret
# 솔라피에 등록한 발신번호 (숫자만, 예: 0212345678)
SOLAPI_SENDER=0212345678
